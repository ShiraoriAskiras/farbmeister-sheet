<div
  class="farbmeister-tab-content inventory-tab"
  data-tab-content="inventory"
  style="--farbmeister-accent: {{selectedColor.accent}};"
>

  <section class="inventory-slot-panel">


    {{!-- =================================================== --}}
    {{!-- HOSENTASCHE                                        --}}
    {{!-- =================================================== --}}

    <section class="inventory-container-section">

      <header class="inventory-container-header">

        <div class="inventory-container-title">

          <span class="inventory-container-icon">
            
          </span>

          <span>
            Hosentasche
          </span>

        </div>


        <span class="inventory-capacity">
          {{pocketCount}} / 2
        </span>

      </header>


      <div class="inventory-slot-grid pocket-grid">

        {{#each pocketSlots}}

          <div
            class="inventory-slot-wrapper {{#if occupied}}occupied{{else}}empty{{/if}}"
            data-inventory-slot
            data-container="{{container}}"
            data-slot="{{slot}}"
          >


            {{#if occupied}}

              <button
                type="button"
                class="inventory-item-main"
                data-action="open-inventory-item"
                data-item-id="{{item.id}}"
                title="{{item.name}} öffnen"
              >

                <img
                  src="{{item.img}}"
                  alt="{{item.name}}"
                >


                <div class="inventory-slot-name">
                  {{item.name}}
                </div>


                <div class="inventory-slot-quantity">
                  ×{{item.quantity}}
                </div>


                {{#unless item.sourceAvailable}}

                  <div
                    class="inventory-source-warning"
                    title="Das ursprüngliche Foundry-Item wurde nicht gefunden."
                  >
                    <i class="fas fa-triangle-exclamation"></i>
                  </div>

                {{/unless}}

              </button>


              <div class="inventory-slot-actions">

                <button
                  type="button"
                  data-action="quantity-minus"
                  data-item-id="{{item.id}}"
                  title="Menge -1"
                >
                  <i class="fas fa-minus"></i>
                </button>


                <button
                  type="button"
                  data-action="quantity-plus"
                  data-item-id="{{item.id}}"
                  title="Menge +1"
                >
                  <i class="fas fa-plus"></i>
                </button>


                <button
                  type="button"
                  data-action="post-inventory-item"
                  data-item-id="{{item.id}}"
                  title="Im Chat zeigen"
                >
                  <i class="fas fa-comment"></i>
                </button>


                <button
                  type="button"
                  class="inventory-remove-button"
                  data-action="remove-inventory-item"
                  data-item-id="{{item.id}}"
                  title="Aus dem Inventar entfernen"
                >
                  <i class="fas fa-xmark"></i>
                </button>

              </div>


            {{else}}

              <div class="inventory-drop-zone">

                <i class="fas fa-arrow-down"></i>

                <span>
                  Item hierher
                </span>

                <small>
                  ziehen
                </small>

              </div>

            {{/if}}

          </div>

        {{/each}}

      </div>

    </section>



    {{!-- =================================================== --}}
    {{!-- RUCKSACK                                            --}}
    {{!-- =================================================== --}}

    <section class="inventory-container-section backpack-section">

      <header class="inventory-container-header">

        <div class="inventory-container-title">

          <span class="inventory-container-icon">
            
          </span>

          <span>
            Rucksack
          </span>

        </div>


        <span class="inventory-capacity">
          {{backpackCount}} / 3
        </span>

      </header>


      <div class="inventory-slot-grid backpack-grid">

        {{#each backpackSlots}}

          <div
            class="inventory-slot-wrapper {{#if occupied}}occupied{{else}}empty{{/if}}"
            data-inventory-slot
            data-container="{{container}}"
            data-slot="{{slot}}"
          >


            {{#if occupied}}

              <button
                type="button"
                class="inventory-item-main"
                data-action="open-inventory-item"
                data-item-id="{{item.id}}"
                title="{{item.name}} öffnen"
              >

                <img
                  src="{{item.img}}"
                  alt="{{item.name}}"
                >


                <div class="inventory-slot-name">
                  {{item.name}}
                </div>


                <div class="inventory-slot-quantity">
                  ×{{item.quantity}}
                </div>


                {{#unless item.sourceAvailable}}

                  <div
                    class="inventory-source-warning"
                    title="Das ursprüngliche Foundry-Item wurde nicht gefunden."
                  >
                    <i class="fas fa-triangle-exclamation"></i>
                  </div>

                {{/unless}}

              </button>


              <div class="inventory-slot-actions">

                <button
                  type="button"
                  data-action="quantity-minus"
                  data-item-id="{{item.id}}"
                  title="Menge -1"
                >
                  <i class="fas fa-minus"></i>
                </button>


                <button
                  type="button"
                  data-action="quantity-plus"
                  data-item-id="{{item.id}}"
                  title="Menge +1"
                >
                  <i class="fas fa-plus"></i>
                </button>


                <button
                  type="button"
                  data-action="post-inventory-item"
                  data-item-id="{{item.id}}"
                  title="Im Chat zeigen"
                >
                  <i class="fas fa-comment"></i>
                </button>


                <button
                  type="button"
                  class="inventory-remove-button"
                  data-action="remove-inventory-item"
                  data-item-id="{{item.id}}"
                  title="Aus dem Inventar entfernen"
                >
                  <i class="fas fa-xmark"></i>
                </button>

              </div>


            {{else}}

              <div class="inventory-drop-zone">

                <i class="fas fa-arrow-down"></i>

                <span>
                  Item hierher
                </span>

                <small>
                  ziehen
                </small>

              </div>

            {{/if}}

          </div>

        {{/each}}

      </div>

    </section>



    {{!-- =================================================== --}}
    {{!-- INVENTARNOTIZEN                                     --}}
    {{!-- =================================================== --}}

    <section class="inventory-notes-section">

      <header class="inventory-notes-header">

        <i class="fas fa-pencil"></i>

        <span>
          Inventarnotizen
        </span>

      </header>


      <textarea
        class="inventory-notes-textarea"
        name="inventoryNotes"
        placeholder="Notizen zum Inventar, Beute, Einkäufe, wichtige Gegenstände..."
      >{{character.inventoryNotes}}</textarea>

    </section>


  </section>

</div>