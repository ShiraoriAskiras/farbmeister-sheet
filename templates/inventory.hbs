<div
  class="farbmeister-tab-content inventory-tab"
  data-tab-content="inventory"
  style="--farbmeister-accent: {{selectedColor.accent}};"
>

  <section class="inventory-slot-panel">


    {{!-- =================================================== --}}
    {{!-- HOSENTASCHE                                        --}}
    {{!-- =================================================== --}}

    <section class="inventory-container-section">

      <header class="inventory-container-header">

        <div class="inventory-container-title">

          <span class="inventory-container-icon">
            
          </span>

          <span>
            Hosentasche
          </span>

        </div>

        <span class="inventory-capacity">
          {{pocketCount}} / 2
        </span>

      </header>


      <div class="inventory-slot-grid pocket-grid">

        {{#each pocketSlots}}

          <div class="inventory-slot-wrapper">


            {{#if occupied}}

              <button
                type="button"
                class="inventory-slot occupied"
                data-action="edit-slot-item"
                data-item-id="{{item.id}}"
                title="{{item.name}} bearbeiten"
              >

                <img
                  src="{{item.img}}"
                  alt="{{item.name}}"
                >

                <div class="inventory-slot-name">
                  {{item.name}}
                </div>

                <div class="inventory-slot-quantity">
                  ×{{item.quantity}}
                </div>

              </button>


              <div class="inventory-slot-actions">

                <button
                  type="button"
                  data-action="post-inventory-item"
                  data-item-id="{{item.id}}"
                  title="Im Chat zeigen"
                >
                  <i class="fas fa-comment"></i>
                </button>

                <button
                  type="button"
                  class="inventory-delete-button"
                  data-action="delete-inventory-item"
                  data-item-id="{{item.id}}"
                  title="Gegenstand löschen"
                >
                  <i class="fas fa-trash"></i>
                </button>

              </div>


            {{else}}

              <button
                type="button"
                class="inventory-slot empty"
                data-action="add-slot-item"
                data-container="{{container}}"
                data-slot="{{slot}}"
                title="Gegenstand hinzufügen"
              >

                <i class="fas fa-plus"></i>

                <span>
                  Hinzufügen
                </span>

              </button>

            {{/if}}

          </div>

        {{/each}}

      </div>

    </section>



    {{!-- =================================================== --}}
    {{!-- RUCKSACK                                            --}}
    {{!-- =================================================== --}}

    <section class="inventory-container-section backpack-section">

      <header class="inventory-container-header">

        <div class="inventory-container-title">

          <span class="inventory-container-icon">
            
          </span>

          <span>
            Rucksack
          </span>

        </div>

        <span class="inventory-capacity">
          {{backpackCount}} / 3
        </span>

      </header>


      <div class="inventory-slot-grid backpack-grid">

        {{#each backpackSlots}}

          <div class="inventory-slot-wrapper">


            {{#if occupied}}

              <button
                type="button"
                class="inventory-slot occupied"
                data-action="edit-slot-item"
                data-item-id="{{item.id}}"
                title="{{item.name}} bearbeiten"
              >

                <img
                  src="{{item.img}}"
                  alt="{{item.name}}"
                >

                <div class="inventory-slot-name">
                  {{item.name}}
                </div>

                <div class="inventory-slot-quantity">
                  ×{{item.quantity}}
                </div>

              </button>


              <div class="inventory-slot-actions">

                <button
                  type="button"
                  data-action="post-inventory-item"
                  data-item-id="{{item.id}}"
                  title="Im Chat zeigen"
                >
                  <i class="fas fa-comment"></i>
                </button>

                <button
                  type="button"
                  class="inventory-delete-button"
                  data-action="delete-inventory-item"
                  data-item-id="{{item.id}}"
                  title="Gegenstand löschen"
                >
                  <i class="fas fa-trash"></i>
                </button>

              </div>


            {{else}}

              <button
                type="button"
                class="inventory-slot empty"
                data-action="add-slot-item"
                data-container="{{container}}"
                data-slot="{{slot}}"
                title="Gegenstand hinzufügen"
              >

                <i class="fas fa-plus"></i>

                <span>
                  Hinzufügen
                </span>

              </button>

            {{/if}}

          </div>

        {{/each}}

      </div>

    </section>

  </section>

</div>